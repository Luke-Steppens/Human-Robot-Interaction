	keywords = {elderly care, emotions, human robot interaction, social robot, speech prosody},
	pages = {3468},
	file = {Full Text PDF:files/699/Lee - 2021 - Generating Robotic Speech Prosody for Human Robot Interaction A Preliminary Study.pdf:application/pdf},
}
